{
	"name": "@meese-os/zork",
	"version": "0.1.0",
	"exports": "./src/session.ts",
	"tasks": {
		"serve": "deno run --allow-net --allow-env --allow-read --allow-sys --allow-ffi src/main.ts",
		"keygen": "deno run src/keygen.ts",
		"test": "deno test --allow-read --allow-env --allow-net --allow-sys --allow-ffi",
		"check": "deno check src/*.ts",
		"hashpw": "deno run src/hashpw.ts"
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 80
	},
	"lint": {
		"rules": {
			"tags": [
				"recommended"
			]
		}
	}
}
